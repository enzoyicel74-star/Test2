local function draw_fov(fov, cfg, dt, anchorFn)
    if not fov or not fov.frame then return end
    if not (cfg.enable and cfg.show_fov) then
        if fov.frame.Visible then fov.frame.Visible = false end
        return
    end
    if cfg.spin_enabled then
        fov.spinAngle = (fov.spinAngle + (cfg.spin_speed or 0) * dt) % 360
    end
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local anchor = anchorFn and anchorFn() or center
    local lerp = math.min(dt * (1 / math.max(cfg.lerp or 0, 0.001)), 1)
    fov.currentPos = fov.currentPos:Lerp(anchor, lerp)
    fov.currentRadius = fov.currentRadius + (cfg.fov_radius - fov.currentRadius) * lerp
    fov.frame.Visible = true
    fov.frame.Size = UDim2.new(0, fov.currentRadius * 2, 0, fov.currentRadius * 2)
    fov.frame.Position = UDim2.new(0, fov.currentPos.X - fov.currentRadius, 0, fov.currentPos.Y - fov.currentRadius)
    fov.frame.Rotation = fov.spinAngle
    fov.frame.BackgroundColor3 = cfg.fill_color1
    fov.frame.BackgroundTransparency = cfg.show_fill and (cfg.fill_transparency or 0.6) or 1
    if cfg.show_fill and cfg.fill_gradient then
        fov.fillGrad.Enabled = true
        fov.fillGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, cfg.fill_color1),
            ColorSequenceKeypoint.new(1, cfg.fill_color2),
        })
        fov.fillGrad.Rotation = fov.spinAngle
    else
        fov.fillGrad.Enabled = false
    end
    if cfg.show_outline and fov.stroke then
        fov.stroke.Visible = true
        fov.stroke.Color = cfg.outline_color1
        fov.stroke.Transparency = cfg.outline_transparency or 0.2
        fov.stroke.Thickness = cfg.outline_thickness or 2
        if cfg.outline_gradient and fov.strokeGrad then
            fov.strokeGrad.Enabled = true
            fov.strokeGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, cfg.outline_color1),
                ColorSequenceKeypoint.new(1, cfg.outline_color2),
            })
            fov.strokeGrad.Rotation = fov.spinAngle
        else
            if fov.strokeGrad then fov.strokeGrad.Enabled = false end
        end
    else
        if fov.stroke then fov.stroke.Visible = false end
        if fov.strokeGrad then fov.strokeGrad.Enabled = false end
    end
end

