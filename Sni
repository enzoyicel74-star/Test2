-- noise filter
do
    local ok, newccl = pcall(function() return newcclosure end)
    if ok and newccl then
        pcall(function()
            local LogService = game:GetService('LogService')
            local old = LogService.MessageOut
            LogService.MessageOut = newccl(function(self, msg, t)
                if type(msg) == 'string' then
                    if msg:find('Remote event invocation') then return end
                    if msg:find('Cloud instance must exist') then return end
                    if msg:find('ReplicateUnreliable') then return end
                    if msg:find('SurfaceAppearance') then return end
                    if msg:find('AppDelegate') then return end
                end
                return old(self, msg, t)
            end)
        end)
    end
end

-- kick protection
do
    local Players = game:GetService('Players')
    local LP = Players.LocalPlayer
    if not LP then repeat task.wait(0.1) until Players.LocalPlayer; LP = Players.LocalPlayer end
    pcall(function() LP.Kick = function() end; LP.kick = function() end end)
    task.spawn(function()
        while task.wait(5) do pcall(function() LP.Kick = function() end end) end
    end)
end

