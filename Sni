local function rb3_pos_for(target_root, dt)
    local mode = state.rb3.attack_position
    local base = target_root.Position
    local look = target_root.CFrame.LookVector
    if mode == 'behind' then return base - look * state.rb3.behind_dist + Vector3.new(0, 2, 0)
    elseif mode == 'front' then return base + look * state.rb3.front_dist + Vector3.new(0, 2, 0)
    elseif mode == 'under' then return base - Vector3.new(0, state.rb3.under_offset, 0)
    elseif mode == 'above' then return base + Vector3.new(0, state.rb3.above_offset, 0)
    elseif mode == 'orbit' then
        rb3_orbit_angle = rb3_orbit_angle + state.rb3.orbit_speed * dt
        local ox = math.cos(rb3_orbit_angle) * state.rb3.orbit_radius
        local oz = math.sin(rb3_orbit_angle) * state.rb3.orbit_radius
        return base + Vector3.new(ox, state.rb3.orbit_height, oz)
    end
    return base + Vector3.new(0, 2, 0)
end

local function rb3_is_reloading()
    if not FighterController or not FighterController.LocalFighter then return false end
    local item = FighterController.LocalFighter.EquippedItem
