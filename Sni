local default_skybox_clone = lighting:FindFirstChildOfClass('Sky') and lighting:FindFirstChildOfClass('Sky'):Clone() or nil

local function update_skybox()
    for _, v in next, lighting:GetChildren() do
        if v:IsA('Sky') then v:Destroy() end
    end
    local W = state.world
    local Sky
    if not W.skybox then
        if default_skybox_clone then
            Sky = default_skybox_clone:Clone()
            Sky.Parent = lighting
        end
    else
        local data = skybox_list[W.skybox_selected]
        if not data then return end
        Sky = Instance.new('Sky')
        Sky.SkyboxBk = data.SkyboxBk; Sky.SkyboxDn = data.SkyboxDn
        Sky.SkyboxFt = data.SkyboxFt; Sky.SkyboxLf = data.SkyboxLf
        Sky.SkyboxRt = data.SkyboxRt; Sky.SkyboxUp = data.SkyboxUp
        Sky.Parent = lighting
    end
    if Sky then
        if W.skybox_remove_sun then Sky.SunTextureId = '' end
        if W.skybox_remove_moon then Sky.MoonTextureId = '' end
        if W.skybox_remove_stars then Sky.StarCount = 0 end
    end
end

