local function isEnemy(player)
    if player == lplr then return false end
    if not state.teamCheck then return true end
    if SpectateController then
        local duel = SpectateController.CurrentDuelSubject
        local localDueler = duel and duel:GetDueler(lplr)
        local localTeam = localDueler and localDueler:Get('TeamID') or nil
        if localTeam and duel and duel.Duelers then
            for _, dueler in duel.Duelers do
                if dueler.Player == player then return dueler:Get('TeamID') ~= localTeam end
            end
        end
    end
    local pTeam = player:GetAttribute('TeamID')
    local lTeam = lplr:GetAttribute('TeamID')
    if pTeam and lTeam then return pTeam ~= lTeam end
    return true
end

local function getClosestTarget()
    local char = lplr.Character
    if not char then return nil, nil, nil end
    local myRoot = char:FindFirstChild('HumanoidRootPart')
    if not myRoot then return nil, nil, nil end
    local cp, cr, ch, cd = nil, nil, nil, 500
    for _, player in ipairs(plrs:GetPlayers()) do
        if not isEnemy(player) then continue end
        local pChar = player.Character
        if not pChar then continue end
        local pRoot = pChar:FindFirstChild('HumanoidRootPart')
        local pHead = pChar:FindFirstChild('Head')
        local pHum = pChar:FindFirstChildWhichIsA('Humanoid')
        if not (pRoot and pHead and pHum and pHum.Health > 0) then continue end
        local dist = (myRoot.Position - pRoot.Position).Magnitude
        if dist < cd then cd = dist; cp = player; cr = pRoot; ch = pHead end
    end
    return cp, cr, ch
end

local function updateDeflection()
    if not FighterController or not FighterController.Objects then return end
    for _, fo in ipairs(FighterController.Objects) do
        local player = fo.Player
        if not player then continue end
        if not fo.Entity or not fo.Entity:IsAlive() or fo:Get('IsSpectating') then
            state.deflecting[player] = false
            continue
        end
        local eq = fo.EquippedItem
        local isKat = eq and eq.ViewModel and eq.ViewModel.Name == 'Katana'
        local isDef = false
        if isKat then
            isDef = (eq._attack_cooldown and eq._attack_cooldown > tick()) or false
        end
        state.deflecting[player] = isDef
    end
end

local function has_riot(plr)
    return ws.ViewModels:FindFirstChild(plr.Name .. ' - Riot Shield - Riot Shield') ~= nil
end

local function check_wall(part)
    local ray = Ray.new(camera.CFrame.Position, part.Position - camera.CFrame.Position)
    local hit = ws:FindPartOnRayWithIgnoreList(ray, {lplr.Character, part.Parent})
    return not hit
end

local function resolve_target(radius)
    local TG = state.targeting
    local closest = TG.max_distance
    local chosen
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, v in ipairs(plrs:GetPlayers()) do
        if v ~= lplr and v.Character then
            local char = v.Character
            local hum = char:FindFirstChildWhichIsA('Humanoid')
            local aim_part = char:FindFirstChild(TG.part)
                or char:FindFirstChild('HitboxHead')
                or char:FindFirstChild('Head')
                or char:FindFirstChild('HumanoidRootPart')

            if hum and hum.Health > 0 and aim_part then
                if state.deflecting[v] then continue end
                if v:GetAttribute('TeamID') == lplr:GetAttribute('TeamID') then continue end
                if TG.visible_only and not check_wall(aim_part) then continue end
                if state.silent_aim.riot_shield and has_riot(v) then continue end

                local pos, on = camera:WorldToViewportPoint(aim_part.Position)
                if on then
                    local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                    if d < closest and d <= radius then
                        chosen = v
                        closest = d
                    end
                end
            end
        end
    end
    return chosen
end

local function get_ping()
    local ok, p = pcall(function()
        return game:GetService('Stats').Network.ServerStatsItem['Data Ping']:GetValue() / 1000
    end)
    return ok and math.clamp(p, 0, 0.35) or 0.05
end

local function predict_pos(part, ping)
    if not part then return Vector3.zero end
    if not state.ragebotPrediction then return part.Position end
    local vel = part.AssemblyLinearVelocity
    return part.Position + vel * ping * 0.9
end

local function best_aim_part(player)
    local char = player and player.Character
    if not char then return nil end
    return char:FindFirstChild('HitboxHead')
        or char:FindFirstChild('Head')
        or char:FindFirstChild('HitboxTorso')
        or char:FindFirstChild('UpperTorso')
        or char:FindFirstChild('HumanoidRootPart')
end

